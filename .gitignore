venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 반입 번들 산출물 (계획서 §9.2) ─────────────────────────────
bundle/
*.whl

# ── 로컬 설정 ─────────────────────────────────────────────────
.env
.env.local

# ── OS / 편집기 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
