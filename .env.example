# 설정 예시 — 이 파일을 `.env` 로 복사해 쓴다.
#
#   cp .env.example .env      (Linux)
#   copy .env.example .env    (Windows)
#
# `.env` 는 .gitignore 에 있다. 로컬 설정이므로 커밋하지 않는다.
# 전체 항목과 기본값은 app/config.py 를 볼 것.
#
# ⚠ 에어갭 (§9.3): 모델 서버 주소는 **폐쇄망 내부 주소**여야 한다.
#   외부 URL 을 넣지 말 것.

# ── 서버 ──────────────────────────────────────────────────────
NDT_HOST=0.0.0.0
NDT_PORT=8080

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
# DEBUG 면 청크별 호출·응답과 DB 기록까지 나온다. 전송 계층(httpcore)의
# 프레임 로그는 자동으로 억제되므로 앱 로그가 묻히지 않는다.
NDT_LOG_LEVEL=INFO

# 프론트가 뜨는 오리진. JSON 배열로 준다.
NDT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── 백엔드 (§4.3) ─────────────────────────────────────────────
# mock      GPU·모델 없이 배선만 확인. 번역 품질 평가에 쓰지 말 것 (§3.1)
# llamacpp  llama.cpp 서버 (개발 환경 권장, §8.2)
# vllm      vLLM 서버 (운영, Phase 3)
# openai    위 둘의 공통 이름. 셋 다 같은 구현을 쓴다
NDT_BACKEND=mock

# 모델 서버 주소. llama.cpp 기본 포트는 8000, vLLM 은 8000/8001 을 흔히 쓴다.
NDT_VLLM_BASE_URL=http://127.0.0.1:8000/v1

# 서빙 중인 모델 이름. 비우면 /v1/models 의 첫 항목을 자동으로 쓴다.
# HF Hub 식별자를 다운로드용으로 넣는 것이 아니다 — 서버가 이미 로컬에서
# 서빙 중인 이름을 그대로 적는다 (§9.3).
NDT_VLLM_SERVED_NAME=

NDT_VLLM_TIMEOUT_S=180

# 번역은 결정적이어야 하므로 온도를 낮게 둔다.
NDT_GEN_TEMPERATURE=0.2
NDT_GEN_TOP_P=0.9
NDT_GEN_MAX_TOKENS=2048

# ── 파이프라인 ────────────────────────────────────────────────
NDT_MAX_INPUT_CHARS=5000
NDT_MAX_CHUNK_CHARS=800
NDT_CHUNK_TERM_LIMIT=10

# 재호출 상한 (§6.5). 다중 접속에서 재시도가 누적되면 큐를 막는다.
NDT_MAX_RETRIES=1

# ── 환각 · 누락 탐지 (§6.5) ───────────────────────────────────
# 원문에 내용이 없으면 모델이 문서를 지어낸다. 실제로 "string" 한 단어에
# 국방 예산안 보도자료가 통째로 나온 적이 있다. 출력/원문 길이 비율과
# 타깃 언어 문자 유무로 잡아 warnings 에 실는다.
#
# 0 이면 방향별 기본값을 쓴다 (한→영 4.0배 / 영→한 2.5배 초과 시 경고).
# 임계값을 조이면 정상 번역이 경고로 덮이고, 사용자가 경고를 무시하게 된다.
NDT_MAX_EXPANSION_RATIO=0
NDT_MIN_LENGTH_RATIO=0
# 이보다 짧은 출력은 비율이 흔들려도 문제 삼지 않는다 (K2 → K2 흑표 등).
NDT_LENGTH_CHECK_MIN_CHARS=40

# 동시성 (§6.6). O-04(동시 접속자 수) 확정 후 조정한다.
NDT_MAX_CONCURRENT_PER_REQUEST=4
NDT_MAX_CONCURRENT_REQUESTS=16

# 프롬프트 프리셋 (§7.9). full = ①~⑥ / compact = ① + ④ + ⑥
# 작은 모델(4B~7B)은 compact 가 나을 수 있다. 평가로 정한다.
NDT_PROMPT_PRESET=full
# press_release(보도자료) | plain_report(평시문) | honorific(높임말) | default(범용)
NDT_DEFAULT_STYLE=plain_report

# ── 형태소 · 문장 분할 (§6.2, §6.6) ───────────────────────────
# Kiwi 사용 여부. false 면 규칙 기반 분할기로 떨어진다 (D-22).
NDT_USE_KIWI=true
# 인스턴스당 사용자 사전 등록에 1~3초 걸린다. 기동 시간과 맞바꾼다.
NDT_KIWI_POOL_SIZE=2
# 비우면 kiwipiepy_model 패키지에서 찾는다. 모델을 파일로 반입한 경우에만
# 절대경로를 준다.
NDT_KIWI_MODEL_PATH=

# ── 저장소 (§5.4) ─────────────────────────────────────────────
NDT_LOG_RETENTION_DAYS=180
# 원문·번역문을 로그에 남길지. 공개 자료만 다루므로(D-03) 기본 true 지만,
# 보존 기간과 접근 권한은 운영 절차에 명시할 것.
NDT_LOG_TEXT=true

# ── 관리 (§6.7) ───────────────────────────────────────────────
# /admin/reload 활성화. 인증이 없으므로 O-07 확정 전까지 켜지 말 것.
NDT_ADMIN_ENABLED=false
